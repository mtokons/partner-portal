portal.mysccg.de, boss.mysccg.de, dev.dieprofessionals.org {
    reverse_proxy portal:3000

    # Optional: Gzip compression for faster loading
    encode gzip

    # Log requests to help with debugging
    log {
        output file /var/log/caddy/access.log
    }
}

wp.mysccg.de {
    reverse_proxy wordpress:80

    encode gzip
    log {
        output file /var/log/caddy/wp-access.log
    }
}
